---
import "../styles/global.css";
import dotenv from "dotenv";
dotenv.config();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Todo</title>
	</head>
	<body class="bg-gray-100 font-sans flex justify-center py-12 px-4 m-0">
		<div
			class="bg-white p-8 md:p-10 rounded-lg shadow-sm w-full max-w-2xl border border-gray-200"
		>
			<h1 class="text-center text-3xl font-bold mb-8 mt-0 text-black">
				Todo App
			</h1>
			<div class="flex gap-3 mb-8">
				<input
					type="text"
					id="new-task-input"
					placeholder="Add a new todo"
					class="flex-grow p-3 border border-gray-200 rounded-md text-base focus:outline-none focus:border-gray-400"
				/>
				<button
					id="add-btn"
					class="bg-gray-900 text-white px-6 py-3 rounded-md font-bold hover:bg-gray-800 transition-colors"
				>
					Add Todo
				</button>
			</div>

			<div id="todos-list"></div>
		</div>
	</body>
</html>

<script>
	const API = `http://localhost:8080`;

	async function loadTodos() {
		try {
			const response = await fetch(`${API}/todos`);
			const todos = await response.json();
			const container = document.getElementById("todos-list");

			if (!container) return;

			interface Todos {
				id: number;
				task: string;
				done: boolean;
				created_at: Date;
				updated_at: Date;
			}
			const htmlTodos = todos
				.map((t: Todos) => {
					const isChecked = t.done ? "checked" : "";
					const textClass = t.done
						? "line-through text-gray-400"
						: "text-gray-800";
					return `
      <div class="flex justify-between items-center bg-gray-50 p-4 rounded-lg mb-3 border border-gray-100">
        <div class="flex items-center gap-4 text-lg">
          <input type="checkbox" ${isChecked} class="w-5 h-5 cursor-pointer accent-gray-900" />
          <span class="${textClass}">${t.task}</span>
        </div>
        <div>
          <button class="bg-white border border-gray-200 p-2 rounded-md cursor-pointer ml-1 hover:bg-gray-100">✏️</button>
          <button class="bg-white border border-gray-200 p-2 rounded-md cursor-pointer ml-1 hover:bg-gray-100">🗑️</button>
        </div>
      </div>
      `;
				})
				.join("");

			container.innerHTML = htmlTodos;
		} catch (error) {
			console.error("Failed to fetch todos:", error);
		}
	}

	loadTodos();
</script>
